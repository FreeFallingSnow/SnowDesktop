include_guard(GLOBAL)

# Use this helper for every new first-party shipping executable. Standalone
# Win32 helper projects read the same version.json as the main application.
function(snowdesktop_add_executable_version_resource target description)
    get_target_property(target_type "${target}" TYPE)
    if(NOT target_type STREQUAL "EXECUTABLE" OR description STREQUAL "")
        message(FATAL_ERROR "Version resources require an executable and a non-empty description: ${target}")
    endif()
    get_filename_component(repository_root "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/.." ABSOLUTE)
    set(version_file "${repository_root}/version.json")
    set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${version_file}")
    file(READ "${version_file}" version_json)
    string(JSON SNOWDESKTOP_VERSION GET "${version_json}" version)
    string(REPLACE "." ";" version_parts "${SNOWDESKTOP_VERSION}")
    list(LENGTH version_parts part_count)
    if(NOT part_count EQUAL 4)
        message(FATAL_ERROR "version.json must contain a four-part version: A.B.C.D")
    endif()
    foreach(part IN LISTS version_parts)
        if(NOT part MATCHES "^(0|[1-9][0-9]*)$" OR part GREATER 65535)
            message(FATAL_ERROR "Invalid Store-compatible version: ${SNOWDESKTOP_VERSION}")
        endif()
    endforeach()
    list(GET version_parts 0 SNOWDESKTOP_VERSION_MAJOR)
    list(GET version_parts 1 SNOWDESKTOP_VERSION_MINOR)
    list(GET version_parts 2 SNOWDESKTOP_VERSION_PATCH)
    list(GET version_parts 3 SNOWDESKTOP_VERSION_REVISION)
    if(SNOWDESKTOP_VERSION_MAJOR EQUAL 0 OR NOT SNOWDESKTOP_VERSION_REVISION EQUAL 0)
        message(FATAL_ERROR "version.json must use Store-compatible A.B.C.0 with A greater than zero")
    endif()
    get_target_property(output_name "${target}" OUTPUT_NAME)
    if(NOT output_name)
        set(output_name "${target}")
    endif()
    set(SNOWDESKTOP_FILE_DESCRIPTION "${description}")
    set(SNOWDESKTOP_ORIGINAL_FILENAME "${output_name}.exe")
    set(SNOWDESKTOP_FILE_TYPE "VFT_APP")
    set(SNOWDESKTOP_LEGAL_COPYRIGHT "Copyright (c) SnowDesktop contributors")
    set(resource "${CMAKE_CURRENT_BINARY_DIR}/generated/version/${target}.version.rc")
    configure_file("${repository_root}/src/resources/version.rc.in" "${resource}" @ONLY)
    target_sources("${target}" PRIVATE "${resource}")
endfunction()

function(snowdesktop_check_executable_version_resources_in_directory directory)
    get_filename_component(repository_root "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/.." ABSOLUTE)
    file(RELATIVE_PATH relative_directory "${repository_root}" "${directory}")
    if(relative_directory MATCHES "^(third_party(/|$)|\\.\\.(/|$))")
        return()
    endif()
    get_property(targets DIRECTORY "${directory}" PROPERTY BUILDSYSTEM_TARGETS)
    foreach(target IN LISTS targets)
        get_target_property(target_type "${target}" TYPE)
        get_target_property(output_directory "${target}" RUNTIME_OUTPUT_DIRECTORY)
        if(NOT target_type STREQUAL "EXECUTABLE" OR output_directory MATCHES "(^|[/\\\\])tests([/\\\\]|$)")
            continue()
        endif()
        get_target_property(source_directory "${target}" SOURCE_DIR)
        get_target_property(sources "${target}" SOURCES)
        set(has_version_resource FALSE)
        foreach(source IN LISTS sources)
            if(NOT source MATCHES "\\.rc$")
                continue()
            endif()
            get_filename_component(resource "${source}" ABSOLUTE BASE_DIR "${source_directory}")
            if(NOT EXISTS "${resource}")
                continue()
            endif()
            file(READ "${resource}" resource_text)
            set(complete TRUE)
            foreach(field IN ITEMS VERSIONINFO FILEVERSION PRODUCTVERSION)
                if(NOT resource_text MATCHES "${field}")
                    set(complete FALSE)
                endif()
            endforeach()
            foreach(field IN ITEMS CompanyName FileDescription FileVersion
                    InternalName OriginalFilename ProductName ProductVersion)
                if(NOT resource_text MATCHES "VALUE[ \t]+\"${field}\"[ \t]*,[ \t]*\"[^\"\\\\][^\"\r\n]*\"")
                    set(complete FALSE)
                endif()
            endforeach()
            if(complete)
                set(has_version_resource TRUE)
                break()
            endif()
        endforeach()
        if(NOT has_version_resource)
            message(FATAL_ERROR
                "Shipping executable ${target} is missing complete Windows version resources. "
                "Call snowdesktop_add_executable_version_resource(${target} \"purpose-specific description\").")
        endif()
    endforeach()
    get_property(children DIRECTORY "${directory}" PROPERTY SUBDIRECTORIES)
    foreach(child IN LISTS children)
        snowdesktop_check_executable_version_resources_in_directory("${child}")
    endforeach()
endfunction()

function(snowdesktop_check_executable_version_resources)
    snowdesktop_check_executable_version_resources_in_directory("${CMAKE_SOURCE_DIR}")
endfunction()

# Run after all targets, including targets appended to CMakeLists.txt later.
cmake_language(DEFER CALL snowdesktop_check_executable_version_resources)
