include_guard(GLOBAL)

# This is an implementation identity, independent of version.json, build paths,
# timestamps and PE version resources. It covers helper targets, their quoted
# local include closure, and the x86 companion sources. Main-only changes do
# not advertise a helper update.
function(snowdesktop_window_support_build_identity)
    set(queue
        "${CMAKE_SOURCE_DIR}/src/dock/dock_minimize_hook_host.cpp"
        "${CMAKE_SOURCE_DIR}/src/dock/dock_cloak_dispatcher.cpp"
        "${CMAKE_SOURCE_DIR}/src/dock/CMakeLists.txt")
    set(identity "window-support-implementation-v1\n${CMAKE_CXX_COMPILER_ID};${CMAKE_CXX_COMPILER_VERSION}\n")
    foreach(target SnowDesktopWindowHelper SnowDesktopWindowSupport SnowDesktopDockMinimizeHook SnowDesktopPerfetto)
        if(NOT TARGET "${target}")
            continue()
        endif()
        get_target_property(sources "${target}" SOURCES)
        get_target_property(source_dir "${target}" SOURCE_DIR)
        foreach(source IN LISTS sources)
            get_filename_component(path "${source}" ABSOLUTE BASE_DIR "${source_dir}")
            if(EXISTS "${path}" AND NOT path MATCHES "[/\\]generated[/\\]")
                list(APPEND queue "${path}")
            endif()
        endforeach()
        foreach(property COMPILE_OPTIONS COMPILE_DEFINITIONS LINK_OPTIONS)
            get_target_property(value "${target}" "${property}")
            if(value)
                string(APPEND identity "${target}.${property}=${value}\n")
            endif()
        endforeach()
    endforeach()
    set(visited)
    while(queue)
        list(POP_FRONT queue path)
        if(path IN_LIST visited OR NOT EXISTS "${path}")
            continue()
        endif()
        list(APPEND visited "${path}")
        file(STRINGS "${path}" includes REGEX "^[ \t]*#[ \t]*include[ \t]*\"[^\"]+\"")
        get_filename_component(parent "${path}" DIRECTORY)
        foreach(line IN LISTS includes)
            string(REGEX REPLACE "^[ \t]*#[ \t]*include[ \t]*\"([^\"]+)\".*$" "\\1" name "${line}")
            foreach(base "${parent}" "${CMAKE_SOURCE_DIR}/src")
                get_filename_component(included "${base}/${name}" ABSOLUTE)
                if(EXISTS "${included}")
                    list(APPEND queue "${included}")
                    break()
                endif()
            endforeach()
        endforeach()
    endwhile()
    list(SORT visited)
    foreach(path IN LISTS visited)
        file(RELATIVE_PATH relative "${CMAKE_SOURCE_DIR}" "${path}")
        file(READ "${path}" contents)
        string(REPLACE "\r\n" "\n" contents "${contents}")
        string(SHA256 digest "${contents}")
        string(APPEND identity "${relative}:${digest}\n")
        set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${path}")
    endforeach()
    string(SHA256 build_id "${identity}")
    file(CONFIGURE OUTPUT "${CMAKE_BINARY_DIR}/generated/window_support_build_inputs.txt" CONTENT "${identity}" @ONLY)
    file(CONFIGURE OUTPUT "${CMAKE_BINARY_DIR}/generated/window_support_build_id.h"
        CONTENT "#pragma once\n#define SNOWDESKTOP_WINDOW_SUPPORT_BUILD_ID \"${build_id}\"\n" @ONLY)
    target_include_directories(SnowDesktopWindowSupport PRIVATE "${CMAKE_BINARY_DIR}/generated")
endfunction()
