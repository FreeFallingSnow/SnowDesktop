<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="SnowDesktop.SettingsShell"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Microsoft.UI.Xaml.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <UserControl.Resources>
        <Style x:Key="SettingsShellCardButtonStyle" TargetType="Button">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="20,16" />
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
        </Style>
        <Style x:Key="SettingsShellCardStyle" TargetType="Border">
            <Setter Property="Padding" Value="20,16" />
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
        </Style>
        <DataTemplate x:Key="SettingsShellFluentGlyphTemplate">
            <Border Width="38" Height="38">
                <TextBlock Text="{Binding}"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           FontSize="18"
                           FontFamily="ms-appx:///Assets/Fonts/FluentSystemIcons-Regular.ttf#FluentSystemIcons-Regular" />
            </Border>
        </DataTemplate>
        <DataTemplate x:Key="SettingsShellFontAwesomeGlyphTemplate">
            <Border Width="38" Height="38">
                <TextBlock Text="{Binding}"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           FontSize="18"
                           FontFamily="ms-appx:///Assets/Fonts/fa-solid-900.ttf#Font Awesome 6 Free" />
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <Grid x:Name="ShellRoot"
          Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid x:Name="IntegratedTitleBarHost"
              Grid.Row="0"
              Height="32"
              Background="Transparent">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="TitleBarLeftInsetColumn" Width="0" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition x:Name="TitleBarRightInsetColumn" Width="0" />
            </Grid.ColumnDefinitions>
        </Grid>

        <NavigationView
            x:Name="NavigationRoot"
            Grid.Row="1"
            Background="Transparent"
            IsSettingsVisible="False"
            IsBackButtonVisible="Collapsed"
            PaneDisplayMode="Left"
            IsPaneOpen="True"
            OpenPaneLength="260"
            IsPaneToggleButtonVisible="False">
            <NavigationView.Resources>
                <SolidColorBrush x:Key="NavigationViewDefaultPaneBackground"
                                 Color="Transparent" />
                <SolidColorBrush x:Key="NavigationViewExpandedPaneBackground"
                                 Color="Transparent" />
            </NavigationView.Resources>
            <NavigationView.PaneHeader>
                <Grid x:Name="SidebarSearchHost"
                      Width="228"
                      Height="32"
                      Margin="16,8,16,12"
                      HorizontalAlignment="Left"
                      VerticalAlignment="Center"
                      ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <AutoSuggestBox
                        x:Name="SettingsSearchBox"
                        Grid.Column="0"
                        HorizontalAlignment="Stretch"
                        QueryIcon="Find"
                        UpdateTextOnSelect="False" />
                    <Button x:Name="ClearSearchButton"
                            Grid.Column="1"
                            Width="32"
                            Height="32"
                            Visibility="Collapsed"
                            Padding="0"
                            VerticalAlignment="Center">
                        <FontIcon Glyph="&#xE894;" FontSize="12" />
                    </Button>
                </Grid>
            </NavigationView.PaneHeader>
            <NavigationView.MenuItems>
                <NavigationViewItem x:Name="HomeItem"
                                    Tag="home"
                                    Visibility="Collapsed">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE80F;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Name="GeneralItem" Tag="general">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE713;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Name="PersonalizationItem" Tag="personalization">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE771;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Name="DesktopItem" Tag="desktop">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE7F4;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Name="DockItem"
                                    Tag="dock-and-taskbar"
                                    Visibility="Collapsed">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xEBC8;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Name="WidgetsItem" Tag="widgets">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xECA5;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Name="DeveloperItem"
                                    Tag="developer-tools"
                                    Visibility="Collapsed">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xEC7A;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Name="BackupItem" Tag="backup-and-data">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE74E;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Name="AboutItem" Tag="about">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE946;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Name="DebugItem"
                                    Tag="debug"
                    Visibility="Collapsed">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE7BA;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <InfoBar x:Name="StatusInfoBar"
                         Grid.Row="0"
                         Margin="24,8,24,8"
                         IsOpen="False"
                         IsClosable="True" />

                <Grid Grid.Row="1">
                    <ScrollViewer x:Name="PageScrollViewer"
                                  HorizontalContentAlignment="Center"
                                  HorizontalScrollMode="Disabled"
                                  HorizontalScrollBarVisibility="Disabled"
                                  VerticalScrollBarVisibility="Auto">
                        <Border x:Name="PageSurface"
                                MaxWidth="1120"
                                Margin="40,16,40,48"
                                HorizontalAlignment="Center">
                            <StackPanel Spacing="16">
                                <BreadcrumbBar x:Name="PageBreadcrumb" />
                                <StackPanel Spacing="4">
                                    <TextBlock x:Name="PageTitle"
                                               FontSize="32"
                                               FontWeight="SemiBold"
                                               TextWrapping="Wrap" />
                                    <TextBlock x:Name="PageSubtitle"
                                               Opacity="0.72"
                                               FontSize="14"
                                               TextWrapping="Wrap"
                                               MaxWidth="780"
                                               HorizontalAlignment="Left" />
                                </StackPanel>
                                <StackPanel x:Name="PageCards" Spacing="8" />
                            </StackPanel>
                        </Border>
                    </ScrollViewer>

                    <Border x:Name="ProgressHost"
                            Visibility="Collapsed"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            MaxWidth="460"
                            MinWidth="280"
                            Padding="24"
                            CornerRadius="12"
                            Background="{ThemeResource AcrylicBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1">
                        <StackPanel Spacing="12">
                            <ProgressRing x:Name="OperationProgressRing"
                                          Width="40"
                                          Height="40"
                                          HorizontalAlignment="Center"
                                          IsActive="False"
                                          IsIndeterminate="True" />
                            <TextBlock x:Name="OperationProgressTitle"
                                       FontSize="18"
                                       FontWeight="SemiBold"
                                       TextAlignment="Center"
                                       TextWrapping="Wrap" />
                            <TextBlock x:Name="OperationProgressMessage"
                                       Opacity="0.72"
                                       TextAlignment="Center"
                                       TextWrapping="Wrap" />
                            <Button x:Name="CancelOperationButton"
                                    HorizontalAlignment="Center"
                                    Visibility="Collapsed" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>
        </NavigationView>

    </Grid>
</UserControl>
