<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="SnowDesktop.SettingsShell"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Microsoft.UI.Xaml.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <UserControl.Resources>
        <Style x:Key="SettingsShellCardButtonStyle" TargetType="Button">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="20,16" />
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
        </Style>
        <Style x:Key="SettingsShellCardStyle" TargetType="Border">
            <Setter Property="Padding" Value="20,16" />
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
        </Style>
    </UserControl.Resources>

    <Grid x:Name="ShellRoot"
          Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <NavigationView
            x:Name="NavigationRoot"
            IsSettingsVisible="False"
            IsBackButtonVisible="Visible"
            IsBackEnabled="False"
            PaneDisplayMode="Auto"
            CompactModeThresholdWidth="640"
            ExpandedModeThresholdWidth="1000"
            OpenPaneLength="260"
            IsPaneToggleButtonVisible="True">
            <NavigationView.MenuItems>
                <NavigationViewItem x:Name="HomeItem" Tag="home">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE80F;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Name="GeneralItem" Tag="general">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE713;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Name="PersonalizationItem" Tag="personalization">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE771;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Name="DesktopItem" Tag="desktop">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE7F4;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Name="DockItem" Tag="dock-and-taskbar">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xEBC8;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Name="WidgetsItem" Tag="widgets">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xECA5;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Name="BackupItem" Tag="backup-and-data">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE74E;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>
            <NavigationView.FooterMenuItems>
                <NavigationViewItem x:Name="DeveloperItem"
                                    Tag="developer-tools"
                                    Visibility="Collapsed">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xEC7A;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Name="DebugItem"
                                    Tag="debug"
                                    Visibility="Collapsed">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE7BA;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Name="AboutItem" Tag="about">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE946;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.FooterMenuItems>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid x:Name="HeaderHost"
                      Grid.Row="0"
                      Padding="24,14,24,8"
                      ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <AutoSuggestBox
                        x:Name="SettingsSearchBox"
                        Grid.Column="0"
                        MaxWidth="680"
                        HorizontalAlignment="Stretch"
                        QueryIcon="Find"
                        UpdateTextOnSelect="False" />
                    <Button x:Name="ClearSearchButton"
                            Grid.Column="1"
                            Visibility="Collapsed"
                            Padding="10"
                            VerticalAlignment="Center">
                        <FontIcon Glyph="&#xE894;" FontSize="12" />
                    </Button>
                </Grid>

                <InfoBar x:Name="StatusInfoBar"
                         Grid.Row="1"
                         Margin="24,0,24,8"
                         IsOpen="False"
                         IsClosable="True" />

                <Grid Grid.Row="2">
                    <ScrollViewer x:Name="PageScrollViewer"
                                  HorizontalScrollBarVisibility="Disabled"
                                  VerticalScrollBarVisibility="Auto">
                        <Border x:Name="PageSurface"
                                MaxWidth="1120"
                                Margin="40,16,40,48"
                                HorizontalAlignment="Stretch">
                            <StackPanel Spacing="16">
                                <BreadcrumbBar x:Name="PageBreadcrumb" />
                                <StackPanel Spacing="4">
                                    <TextBlock x:Name="PageTitle"
                                               FontSize="32"
                                               FontWeight="SemiBold"
                                               TextWrapping="Wrap" />
                                    <TextBlock x:Name="PageSubtitle"
                                               Opacity="0.72"
                                               FontSize="14"
                                               TextWrapping="Wrap"
                                               MaxWidth="780"
                                               HorizontalAlignment="Left" />
                                </StackPanel>
                                <StackPanel x:Name="PageCards" Spacing="8" />
                            </StackPanel>
                        </Border>
                    </ScrollViewer>

                    <Border x:Name="ProgressHost"
                            Visibility="Collapsed"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            MaxWidth="460"
                            MinWidth="280"
                            Padding="24"
                            CornerRadius="12"
                            Background="{ThemeResource AcrylicBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1">
                        <StackPanel Spacing="12">
                            <ProgressRing x:Name="OperationProgressRing"
                                          Width="40"
                                          Height="40"
                                          HorizontalAlignment="Center"
                                          IsActive="False"
                                          IsIndeterminate="True" />
                            <TextBlock x:Name="OperationProgressTitle"
                                       FontSize="18"
                                       FontWeight="SemiBold"
                                       TextAlignment="Center"
                                       TextWrapping="Wrap" />
                            <TextBlock x:Name="OperationProgressMessage"
                                       Opacity="0.72"
                                       TextAlignment="Center"
                                       TextWrapping="Wrap" />
                            <Button x:Name="CancelOperationButton"
                                    HorizontalAlignment="Center"
                                    Visibility="Collapsed" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>
        </NavigationView>

        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="WidthStates">
                <VisualState x:Name="NarrowState">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="0" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="HeaderHost.Padding" Value="12,10,12,6" />
                        <Setter Target="StatusInfoBar.Margin" Value="12,0,12,6" />
                        <Setter Target="PageSurface.Margin" Value="16,10,16,32" />
                        <Setter Target="PageTitle.FontSize" Value="26" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="WideState">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="840" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="HeaderHost.Padding" Value="24,14,24,8" />
                        <Setter Target="StatusInfoBar.Margin" Value="24,0,24,8" />
                        <Setter Target="PageSurface.Margin" Value="40,16,40,48" />
                        <Setter Target="PageTitle.FontSize" Value="32" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
    </Grid>
</UserControl>
