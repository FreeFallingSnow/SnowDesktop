<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="SnowDesktop.SettingsShell"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Microsoft.UI.Xaml.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <UserControl.Resources>
        <Style x:Key="SettingsShellCardButtonStyle" TargetType="Button">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="20,16" />
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
        </Style>
        <Style x:Key="SettingsShellCardStyle" TargetType="Border">
            <Setter Property="Padding" Value="20,16" />
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
        </Style>
        <DataTemplate x:Key="SettingsShellFluentGlyphTemplate">
            <Border Width="38" Height="38">
                <TextBlock Text="{Binding}"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           FontSize="18"
                           FontFamily="ms-appx:///Assets/Fonts/FluentSystemIcons-Regular.ttf#FluentSystemIcons-Regular" />
            </Border>
        </DataTemplate>
        <DataTemplate x:Key="SettingsShellFontAwesomeGlyphTemplate">
            <Border Width="38" Height="38">
                <TextBlock Text="{Binding}"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           FontSize="18"
                           FontFamily="ms-appx:///Assets/Fonts/fa-solid-900.ttf#Font Awesome 6 Free" />
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <Grid x:Name="ShellRoot"
          Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="WindowWidthStates">
                <VisualState x:Name="CompactContent">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="0" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="PageSurface.Margin" Value="20,12,20,32" />
                        <Setter Target="PageTitle.FontSize" Value="28" />
                        <Setter Target="PageHeaderIconHost.Width" Value="30" />
                        <Setter Target="PageHeaderIconHost.Height" Value="30" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="WideContent">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="1008" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="PageSurface.Margin" Value="40,16,40,48" />
                        <Setter Target="PageTitle.FontSize" Value="32" />
                        <Setter Target="PageHeaderIconHost.Width" Value="36" />
                        <Setter Target="PageHeaderIconHost.Height" Value="36" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid x:Name="IntegratedTitleBarHost"
              Grid.Row="0"
              Height="32"
              Background="Transparent">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="TitleBarLeftInsetColumn" Width="0" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition x:Name="TitleBarRightInsetColumn" Width="0" />
            </Grid.ColumnDefinitions>
        </Grid>

        <NavigationView
            x:Name="NavigationRoot"
            Grid.Row="1"
            Background="Transparent"
            IsSettingsVisible="False"
            IsBackButtonVisible="Auto"
            PaneDisplayMode="Auto"
            CompactModeThresholdWidth="720"
            ExpandedModeThresholdWidth="1008"
            OpenPaneLength="260"
            IsPaneToggleButtonVisible="True">
            <NavigationView.Resources>
                <SolidColorBrush x:Key="NavigationViewDefaultPaneBackground"
                                 Color="Transparent" />
                <SolidColorBrush x:Key="NavigationViewExpandedPaneBackground"
                                 Color="Transparent" />
            </NavigationView.Resources>
            <NavigationView.PaneHeader>
                <Grid x:Name="SidebarSearchHost"
                      Height="32"
                      Margin="16,8,16,12"
                      HorizontalAlignment="Stretch"
                      VerticalAlignment="Center"
                      ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <AutoSuggestBox
                        x:Name="SettingsSearchBox"
                        Grid.Column="0"
                        HorizontalAlignment="Stretch"
                        QueryIcon="Find"
                        UpdateTextOnSelect="False" />
                    <Button x:Name="ClearSearchButton"
                            Grid.Column="1"
                            Width="32"
                            Height="32"
                            Visibility="Collapsed"
                            Padding="0"
                            VerticalAlignment="Center">
                        <FontIcon Glyph="&#xE894;" FontSize="12" />
                    </Button>
                </Grid>
            </NavigationView.PaneHeader>
            <NavigationView.MenuItems>
                <NavigationViewItem x:Name="HomeItem"
                                    Tag="home"
                                    Visibility="Collapsed">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE80F;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Name="GeneralItem" Tag="general">
                    <NavigationViewItem.Icon><ImageIcon Source="ms-appx:///Assets/Settings/Icons/general.svg" Width="22" Height="22" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Name="PersonalizationItem" Tag="personalization">
                    <NavigationViewItem.Icon><ImageIcon Source="ms-appx:///Assets/Settings/Icons/appearance.svg" Width="22" Height="22" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItemHeader x:Name="DesktopShellHeader" />
                <NavigationViewItem x:Name="DesktopItem" Tag="desktop">
                    <NavigationViewItem.Icon><ImageIcon Source="ms-appx:///Assets/Settings/Icons/desktop.svg" Width="22" Height="22" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Name="CategoriesItem" Tag="desktop-categories">
                    <NavigationViewItem.Icon><ImageIcon Source="ms-appx:///Assets/Settings/Icons/categories.svg" Width="22" Height="22" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Name="DockItem" Tag="dock">
                    <NavigationViewItem.Icon><ImageIcon Source="ms-appx:///Assets/Settings/Icons/dock.svg" Width="22" Height="22" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Name="TaskbarItem" Tag="taskbar">
                    <NavigationViewItem.Icon><ImageIcon Source="ms-appx:///Assets/Settings/Icons/taskbar.svg" Width="22" Height="22" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Name="WidgetsItem" Tag="widgets">
                    <NavigationViewItem.Icon><ImageIcon Source="ms-appx:///Assets/Settings/Icons/widgets.svg" Width="22" Height="22" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItemHeader x:Name="DataHeader" />
                <NavigationViewItem x:Name="BackupItem" Tag="backup-and-data">
                    <NavigationViewItem.Icon><ImageIcon Source="ms-appx:///Assets/Settings/Icons/backup.svg" Width="22" Height="22" /></NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>
            <NavigationView.FooterMenuItems>
                <NavigationViewItem x:Name="AboutItem" Tag="about">
                    <NavigationViewItem.Icon><ImageIcon Source="ms-appx:///Assets/Settings/Icons/about.svg" Width="22" Height="22" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Name="DeveloperItem"
                                    Tag="developer-tools"
                                    Visibility="Collapsed">
                    <NavigationViewItem.Icon><ImageIcon Source="ms-appx:///Assets/Settings/Icons/developer.svg" Width="22" Height="22" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Name="DebugItem"
                                    Tag="debug"
                                    Visibility="Collapsed">
                    <NavigationViewItem.Icon><ImageIcon Source="ms-appx:///Assets/Settings/Icons/debug.svg" Width="22" Height="22" /></NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.FooterMenuItems>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <InfoBar x:Name="StatusInfoBar"
                         Grid.Row="0"
                         Margin="24,8,24,8"
                         IsOpen="False"
                         IsClosable="True" />

                <Grid Grid.Row="1">
                    <ScrollViewer x:Name="PageScrollViewer"
                                  MaxWidth="1200"
                                  HorizontalAlignment="Stretch"
                                  HorizontalContentAlignment="Stretch"
                                  HorizontalScrollBarVisibility="Disabled"
                                  VerticalScrollBarVisibility="Auto">
                        <Border x:Name="PageSurface"
                                MaxWidth="1120"
                                Margin="40,16,40,48"
                                HorizontalAlignment="Stretch">
                            <StackPanel Spacing="16">
                                <BreadcrumbBar x:Name="PageBreadcrumb" />
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <ContentControl x:Name="PageHeaderIconHost"
                                                    Width="36"
                                                    Height="36"
                                                    IsTabStop="False"
                                                    HorizontalContentAlignment="Stretch"
                                                    VerticalContentAlignment="Stretch"
                                                    VerticalAlignment="Top" />
                                    <StackPanel Grid.Column="1" Spacing="4">
                                        <TextBlock x:Name="PageTitle"
                                                   FontSize="32"
                                                   FontWeight="SemiBold"
                                                   TextWrapping="Wrap" />
                                        <TextBlock x:Name="PageSubtitle"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                   FontSize="14"
                                                   TextWrapping="Wrap"
                                                   MaxWidth="780"
                                                   HorizontalAlignment="Left" />
                                    </StackPanel>
                                </Grid>
                                <StackPanel x:Name="PageCards" Spacing="8" />
                            </StackPanel>
                        </Border>
                    </ScrollViewer>

                    <Border x:Name="ProgressHost"
                            Visibility="Collapsed"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            MaxWidth="460"
                            MinWidth="280"
                            Padding="24"
                            CornerRadius="12"
                            Background="{ThemeResource AcrylicBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1">
                        <StackPanel Spacing="12">
                            <ProgressRing x:Name="OperationProgressRing"
                                          Width="40"
                                          Height="40"
                                          HorizontalAlignment="Center"
                                          IsActive="False"
                                          IsIndeterminate="True" />
                            <TextBlock x:Name="OperationProgressTitle"
                                       FontSize="18"
                                       FontWeight="SemiBold"
                                       TextAlignment="Center"
                                       TextWrapping="Wrap" />
                            <TextBlock x:Name="OperationProgressMessage"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       TextAlignment="Center"
                                       TextWrapping="Wrap" />
                            <Button x:Name="CancelOperationButton"
                                    HorizontalAlignment="Center"
                                    Visibility="Collapsed" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>
        </NavigationView>

    </Grid>
</UserControl>
