# Match the repository's LF editor policy on checkout, independent of core.autocrlf.
* text=auto eol=lf
*.bat text eol=crlf
*.cmd text eol=crlf

# Preserve official vendored sources and license files byte-for-byte.
third_party/libwebp/** -whitespace -text
third_party/puff/** -whitespace -text
third_party/perfetto/** -whitespace -text
