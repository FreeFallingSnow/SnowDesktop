{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 24,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "release",
      "displayName": "Release",
      "binaryDir": "${sourceDir}/.build",
      "cacheVariables": {
        "BUILD_TESTING": false
      }
    },
    {
      "name": "debug",
      "displayName": "Debug",
      "inherits": "release",
      "binaryDir": "${sourceDir}/.build_debug"
    },
    {
      "name": "tests",
      "displayName": "Release tests",
      "inherits": "release",
      "cacheVariables": {
        "BUILD_TESTING": true
      }
    }
  ],
  "buildPresets": [
    {
      "name": "release",
      "configurePreset": "release",
      "configuration": "Release",
      "jobs": 4,
      "targets": [
        "SnowDesktopReleaseBuild"
      ]
    },
    {
      "name": "debug",
      "configurePreset": "debug",
      "configuration": "Debug",
      "jobs": 4,
      "targets": [
        "SnowDesktopDebugBuild"
      ]
    },
    {
      "name": "tests",
      "configurePreset": "tests",
      "configuration": "Release",
      "jobs": 4,
      "targets": [
        "SnowDesktopAppTests"
      ]
    },
    {
      "name": "all-tests",
      "displayName": "All existing native application tests",
      "configurePreset": "tests",
      "configuration": "Release",
      "jobs": 4,
      "targets": [
        "SnowDesktopTests"
      ]
    },
    {
      "name": "core-tests",
      "displayName": "Release core tests",
      "configurePreset": "tests",
      "configuration": "Release",
      "jobs": 4,
      "targets": [
        "SnowDesktopCoreTests"
      ]
    },
    {
      "name": "fast-tests",
      "displayName": "Release tests excluding integration",
      "configurePreset": "tests",
      "configuration": "Release",
      "jobs": 4,
      "targets": [
        "SnowDesktopFastTests"
      ]
    }
  ],
  "testPresets": [
    {
      "name": "all-tests",
      "displayName": "All tests including manual diagnostics",
      "configurePreset": "tests",
      "configuration": "Release",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "jobs": 24
      }
    },
    {
      "name": "tests",
      "displayName": "Full application suite excluding manual and temporary diagnostics",
      "inherits": "all-tests",
      "filter": {
        "exclude": {
          "label": "^(manual|temporary|tools)$"
        }
      }
    },
    {
      "name": "core-tests",
      "displayName": "Release core tests",
      "inherits": "tests",
      "filter": {
        "include": {
          "label": "^core$"
        }
      },
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "fast-tests",
      "displayName": "Automatic tests excluding integration",
      "inherits": "tests",
      "filter": {
        "exclude": {
          "label": "^(integration|manual|temporary|tools)$"
        }
      }
    }
  ]
}
